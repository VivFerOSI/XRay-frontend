# URL base de la API del backend (NestJS). Incluye el prefijo /api.
# Local:      http://localhost:3000/api
# Producción: https://<servicio-cloud-run>/api
VITE_API_URL=http://localhost:3000/api

# Formspree — ID del formulario de contacto.
# Se obtiene al crear el form en https://formspree.io (la parte final del
# endpoint: formspree.io/f/XXXXXXXX  →  el ID es XXXXXXXX).
VITE_FORMSPREE_ID=

# Publica el bloque "Gestión del desempeño" en la página de Servicios, con las
# autoevaluaciones del Evaluador y de la Persona Evaluada.
# Vacío o cualquier otro valor lo deja escondido. Que los cuestionarios se
# puedan abrir lo decide aparte la columna `activo` del backend.
VITE_GESTION_DESEMPENO=true

# Publica el panel de administración (/admin). Sólo "true" lo muestra.
# El backend además tiene que tener ADMIN_PANEL_ENABLED=true, si no responde 404.
VITE_ADMIN=false
