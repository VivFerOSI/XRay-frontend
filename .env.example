# URL base de la API del backend (NestJS). Incluye el prefijo /api.
# Local:      http://localhost:3000/api
# Producción: https://<servicio-cloud-run>/api
VITE_API_URL=http://localhost:3000/api

# Formspree — ID del formulario de contacto.
# Se obtiene al crear el form en https://formspree.io (la parte final del
# endpoint: formspree.io/f/XXXXXXXX  →  el ID es XXXXXXXX).
VITE_FORMSPREE_ID=
